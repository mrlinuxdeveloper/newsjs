<style>
    @import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap');

    .site-nav{
        --paper:#FAF7F1;
        --ink:#1E1B16;
        --muted:#8A8175;
        --line:#E4DED2;
        --forest:#2E5E4E;
        --forest-2:#3E7A64;
        --forest-soft:#E4EFEA;

        direction: rtl;
        font-family: 'Vazirmatn', sans-serif;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .site-nav .nav-inner{
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border-bottom: 1px solid var(--line);
        padding: 0 26px;
        height: 68px;
        box-shadow: 0 6px 20px rgba(30,27,22,.04);
    }

    .site-nav .brand{
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        color: var(--ink);
        flex-shrink: 0;
    }

    .site-nav .brand .logo-box{
        width: 36px; height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg, var(--forest) 0%, var(--forest-2) 100%);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 15px;
        box-shadow: 0 5px 12px rgba(46,94,78,.3);
    }

    .site-nav .brand span{
        font-weight: 800;
        font-size: 16.5px;
    }

    .site-nav ul{
        display: flex;
        align-items: center;
        gap: 4px;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .site-nav ul li a{
        position: relative;
        display: inline-block;
        text-decoration: none;
        color: var(--muted);
        font-size: 14px;
        font-weight: 600;
        padding: 10px 16px;
        border-radius: 10px;
        transition: color .18s, background .18s;
    }

    .site-nav ul li a::after{
        content: "";
        position: absolute;
        right: 16px; left: 16px; bottom: 6px;
        height: 2px;
        border-radius: 2px;
        background: var(--forest);
        transform: scaleX(0);
        transition: transform .2s;
    }

    .site-nav ul li a:hover{
        color: var(--forest);
        background: var(--forest-soft);
    }

    .site-nav ul li a:hover::after{ transform: scaleX(1); }

    .site-nav ul li a.active{
        color: #fff;
        background: linear-gradient(135deg, var(--forest) 0%, var(--forest-2) 100%);
    }

    .site-nav ul li a.active::after{ display: none; }

    /* ===== دکمه همبرگر (موبایل) ===== */
    .site-nav .burger{
        display: none;
        width: 38px; height: 38px;
        border-radius: 10px;
        border: 1px solid var(--line);
        background: #fff;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-direction: column;
        gap: 4px;
    }

    .site-nav .burger span{
        width: 18px; height: 2px;
        background: var(--ink);
        border-radius: 2px;
        transition: .25s;
    }

    .site-nav .burger.open span:nth-child(1){ transform: translateY(6px) rotate(45deg); }
    .site-nav .burger.open span:nth-child(2){ opacity: 0; }
    .site-nav .burger.open span:nth-child(3){ transform: translateY(-6px) rotate(-45deg); }

    @media (max-width: 640px){
        .site-nav ul{
            position: absolute;
            top: 68px; right: 0; left: 0;
            background: #fff;
            border-bottom: 1px solid var(--line);
            flex-direction: column;
            align-items: stretch;
            gap: 2px;
            padding: 10px 16px 16px;
            box-shadow: 0 14px 24px rgba(30,27,22,.08);
            display: none;
        }

        .site-nav ul.show{ display: flex; }

        .site-nav ul li a{ display: block; padding: 12px 14px; }

        .site-nav .burger{ display: flex; }
    }
</style>

<nav class="site-nav">
    <div class="nav-inner">
        <a href="/" class="brand">
            <div class="logo-box">ف</div>
            <span>فروشگاه</span>
        </a>

        <ul id="siteNavLinks">
            <li><a href="/" class="active">خانه</a></li>
            <li><a href="/about">درباره ما</a></li>
            <li><a href="/blog">خبر</a></li>
        </ul>

        <button class="burger" id="navBurger" type="button" aria-label="منو">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

<script>
    const burger = document.getElementById('navBurger');
    const links = document.getElementById('siteNavLinks');

    burger.addEventListener('click', () => {
        burger.classList.toggle('open');
        links.classList.toggle('show');
    });
</script>